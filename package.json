{
  "name": "bitbucket-dc-axi",
  "version": "0.1.0",
  "description": "Agent-facing Bitbucket Data Center CLI with compact TOON output",
  "type": "module",
  "author": "Nikolay Seliverstov",
  "contributors": [
    "Kit Chan"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postpersonality/bitbucket-dc-axi.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "bitbucket-dc-axi": "dist/bin/bitbucket-dc-axi.js"
  },
  "files": [
    "dist",
    "skills/bitbucket-dc-axi",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/bin/bitbucket-dc-axi.js', 0o755)\"",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "build:skill": "tsx scripts/build-skill.ts",
    "dev": "tsx bin/bitbucket-dc-axi.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "bitbucket",
    "bitbucket-data-center",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "@toon-format/toon": "^2.1.0",
    "axi-sdk-js": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
